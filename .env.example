# Shared runtime mode: development | test | production
APP_ENV=development

# Required. Use a placeholder here; keep real credentials in the local .env only.
DATABASE_URL=postgresql://bros:change-me@localhost:5432/bros

# Docker Compose PostgreSQL 18 development service.
POSTGRES_DB=bros
POSTGRES_USER=bros
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Development defaults are shown explicitly for reproducibility.
API_HOST=127.0.0.1
API_PORT=3000
WORKER_CONCURRENCY=1

# Storage credentials belong to SecretProvider (P1-13), not this file.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage

# P1-13 secret keys. Keep placeholders empty and provide real values only in local/host secret injection.
BROS_SECRET_STORAGE_R2_ACCESS_KEY_ID=
BROS_SECRET_STORAGE_R2_SECRET_ACCESS_KEY=
BROS_SECRET_PROVIDER_IMAGE_API_KEY=
BROS_SECRET_PROVIDER_SEARCH_API_KEY=
BROS_SECRET_BROWSER_PROFILE_DEFAULT_USERNAME=
BROS_SECRET_BROWSER_PROFILE_DEFAULT_PASSWORD=
BROS_SECRET_BROWSER_PROFILE_DEFAULT_OTP_SEED=
BROS_SECRET_BROWSER_PROFILE_DEFAULT_COOKIE=
BROS_SECRET_BROWSER_PROFILE_DEFAULT_ACCESS_TOKEN=
