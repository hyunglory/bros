{
	persist_config off
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	basic_auth {
		import /run/secrets/caddy_auth
	}

	@identity path /__staging/identity
	handle @identity {
		reverse_proxy 127.0.0.1:{$BROS_IDENTITY_PORT} {
			header_up -Authorization
			header_up X-BROS-Actor "{http.auth.user.id}"
			import /run/secrets/caddy_proxy
		}
	}

	@api path /api/* /health /ready
	handle @api {
		reverse_proxy 127.0.0.1:{$BROS_API_PORT} {
			header_up -Authorization
			header_up X-BROS-Actor "{http.auth.user.id}"
			import /run/secrets/caddy_proxy
		}
	}

	handle {
		root * /srv/bros-admin
		try_files {path} /index.html
		file_server
	}
}
